{
  "version": 3,
  "configurePresets": [
    {
      "name": "host-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "RTOS_STDCPP_BUILD_LIBRARY": "OFF",
        "RTOS_STDCPP_BUILD_HOST_TESTS": "ON"
      }
    },
    {
      "name": "host-release",
      "inherits": "host-debug",
      "binaryDir": "${sourceDir}/build/host-release",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}
    }
  ],
  "buildPresets": [
    {"name": "host-debug", "configurePreset": "host-debug"},
    {"name": "host-release", "configurePreset": "host-release"}
  ],
  "testPresets": [
    {"name": "host-debug", "configurePreset": "host-debug", "output": {"outputOnFailure": true}},
    {"name": "host-release", "configurePreset": "host-release", "output": {"outputOnFailure": true}}
  ]
}
