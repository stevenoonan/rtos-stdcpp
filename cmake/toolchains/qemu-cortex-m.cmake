list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES RTOS_STDCPP_TOOLCHAIN_ROOT RTOS_STDCPP_CORTEX_M)
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
if(NOT RTOS_STDCPP_TOOLCHAIN_ROOT OR NOT RTOS_STDCPP_CORTEX_M MATCHES "^(m4|m7|m55)$")
    message(FATAL_ERROR "Set RTOS_STDCPP_TOOLCHAIN_ROOT and RTOS_STDCPP_CORTEX_M=m4|m7|m55")
endif()
set(CMAKE_C_COMPILER "${RTOS_STDCPP_TOOLCHAIN_ROOT}/bin/arm-none-eabi-gcc")
set(CMAKE_CXX_COMPILER "${RTOS_STDCPP_TOOLCHAIN_ROOT}/bin/arm-none-eabi-g++")
set(CMAKE_ASM_COMPILER "${CMAKE_C_COMPILER}")
file(READ "${CMAKE_CURRENT_LIST_DIR}/../profiles/qemu-${RTOS_STDCPP_CORTEX_M}-gcc-14.3.1-cxx17.json" profile)
string(JSON count LENGTH "${profile}" cpu_flags)
math(EXPR last "${count} - 1")
set(flags)
foreach(index RANGE ${last})
    string(JSON flag GET "${profile}" cpu_flags ${index})
    string(APPEND flags " ${flag}")
endforeach()
set(CMAKE_C_FLAGS_INIT "${flags}")
set(CMAKE_CXX_FLAGS_INIT "${flags}")
set(CMAKE_ASM_FLAGS_INIT "${flags}")
