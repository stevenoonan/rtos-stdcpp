# SPDX-License-Identifier: MIT
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES RTOS_STDCPP_TOOLCHAIN_ROOT)
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
if(NOT DEFINED RTOS_STDCPP_TOOLCHAIN_ROOT)
    message(FATAL_ERROR "Set RTOS_STDCPP_TOOLCHAIN_ROOT to an arm-none-eabi toolchain")
endif()
set(CMAKE_C_COMPILER "${RTOS_STDCPP_TOOLCHAIN_ROOT}/bin/arm-none-eabi-gcc")
set(CMAKE_CXX_COMPILER "${RTOS_STDCPP_TOOLCHAIN_ROOT}/bin/arm-none-eabi-g++")
set(CMAKE_ASM_COMPILER "${CMAKE_C_COMPILER}")
set(CMAKE_C_FLAGS_INIT "-marm -mcpu=cortex-a9 -mfpu=vfpv3 -mfloat-abi=hard")
set(CMAKE_CXX_FLAGS_INIT "${CMAKE_C_FLAGS_INIT}")
set(CMAKE_ASM_FLAGS_INIT "${CMAKE_C_FLAGS_INIT}")
